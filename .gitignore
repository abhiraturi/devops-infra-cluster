# Local .terraform directories
**/.terraform/*

# .tfstate files (NEVER COMMIT THESE)
*.tfstate
*.tfstate.*
*.tfvars

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
*.tfvars
*.tfvars.json

# Ignore local secret files
*.secret
*.key

# OS generated files
.DS_Store